# ---- Database ----
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ---- NextAuth / Auth.js ----
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- bKash (Merchant Tokenized Checkout) ----
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""

# ---- SSLCommerz ----
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"

# ---- Steadfast Courier ----
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""

# ---- Cloudinary (unsigned client upload) ----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ---- Email (Resend, for password reset) ----
RESEND_API_KEY=""
EMAIL_FROM="BD Shop <no-reply@yourdomain.com>"

# ---- SMS (any BD gateway exposing a simple GET API — BulkSMSBD/Alpha SMS/etc.) ----
SMS_API_URL="https://bulksmsbd.net/api/smsapi"
SMS_API_KEY=""
SMS_SENDER_ID=""

# ---- WhatsApp support button (optional — leave blank to hide the button) ----
NEXT_PUBLIC_WHATSAPP_NUMBER="8801770886813"
